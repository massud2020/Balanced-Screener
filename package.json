{
  "name": "balanced-screener",
  "version": "1.0.0",
  "private": true,
  "description": "Balanced Screener — Android App",
  "scripts": {
    "test": "jest --verbose --runInBand",
    "test:watch": "jest --watch",
    "build:www": "node build-www.js",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android": "npm run build:www && npm run cap:sync"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@img/sharp-wasm32": "^0.35.5",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "$sharp"
    }
  },
  "config": {
    "sharp_binary_host": "https://npmmirror.com/mirrors/sharp",
    "sharp_libvips_binary_host": "https://npmmirror.com/mirrors/sharp-libvips"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "transform": {}
  }
}
